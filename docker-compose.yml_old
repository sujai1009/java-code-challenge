version: '3.8'

services:
  mysql:
    image: mysql:8.0
    container_name: devices-mysql
    command: --default-authentication-plugin=mysql_native_password
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: devices_db
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - devices-network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-proot"]
      interval: 10s
      timeout: 10s
      retries: 10

  app:
    build: .
    container_name: devices-api
    ports:
      - "8080:8080"
    environment:
      - SPRING_PROFILES_ACTIVE=mysql
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - devices-network

volumes:
  mysql_data:

networks:
  devices-network:
    driver: bridge
