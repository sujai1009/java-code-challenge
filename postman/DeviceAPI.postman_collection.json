      "name": "1. Create Device",
      "item": [
        {
          "name": "Create Device - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success flag\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Response has message\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"Device created successfully\");",
                  "});",
                  "",
                  "pm.test(\"Response data contains device\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property(\"id\");",
                  "    pm.expect(jsonData.data).to.have.property(\"name\", \"iPhone 15\");",
                  "    pm.expect(jsonData.data).to.have.property(\"brand\", \"Apple\");",
                  "    pm.expect(jsonData.data).to.have.property(\"state\", \"AVAILABLE\");",
                  "    pm.expect(jsonData.data).to.have.property(\"creationTime\");",
                  "    pm.expect(jsonData.data).to.have.property(\"updatedAt\");",
                  "});",
                  "",
                  "// Save device ID for subsequent tests",
                  "const jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"createdDeviceId\", jsonData.data.id);",
                  "pm.environment.set(\"createdDeviceId\", jsonData.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15\",\n  \"brand\": \"Apple\",\n  \"state\": \"AVAILABLE\"\n}"
